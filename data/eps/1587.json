{"id": 1587, "updated": "2026-10-14", "episodes": [{"n": 1, "t": "On a Summer Night", "e": {"sub": "https://megaplay.buzz/stream/s-2/1740/sub", "dub": "https://megaplay.buzz/stream/s-2/1740/dub"}}, {"n": 2, "t": "The hazed early dawn light comes not from the moon", "e": {"sub": "https://megaplay.buzz/stream/s-2/1741/sub", "dub": "https://megaplay.buzz/stream/s-2/1741/dub"}}, {"n": 3, "t": "But from the crystal white snow of Yoshino", "e": {"sub": "https://megaplay.buzz/stream/s-2/1742/sub", "dub": "https://megaplay.buzz/stream/s-2/1742/dub"}}, {"n": 4, "t": "Nobody wishes to see", "e": {"sub": "https://megaplay.buzz/stream/s-2/1743/sub", "dub": "https://megaplay.buzz/stream/s-2/1743/dub"}}, {"n": 5, "t": "Mount Amanokagu", "e": {"sub": "https://megaplay.buzz/stream/s-2/1744/sub", "dub": "https://megaplay.buzz/stream/s-2/1744/dub"}}, {"n": 6, "t": "Tatsuta River Ablaze", "e": {"sub": "https://megaplay.buzz/stream/s-2/1745/sub", "dub": "https://megaplay.buzz/stream/s-2/1745/dub"}}, {"n": 7, "t": "The storm blasts", "e": {"sub": "https://megaplay.buzz/stream/s-2/1746/sub", "dub": "https://megaplay.buzz/stream/s-2/1746/dub"}}, {"n": 8, "t": "As friends and strangers", "e": {"sub": "https://megaplay.buzz/stream/s-2/1747/sub", "dub": "https://megaplay.buzz/stream/s-2/1747/dub"}}, {"n": 9, "t": "I recall how my own efforts were in vain", "e": {"sub": "https://megaplay.buzz/stream/s-2/1748/sub", "dub": "https://megaplay.buzz/stream/s-2/1748/dub"}}, {"n": 10, "t": "Scarlet kadsuras", "e": {"sub": "https://megaplay.buzz/stream/s-2/1749/sub", "dub": "https://megaplay.buzz/stream/s-2/1749/dub"}}, {"n": 11, "t": "Leaving a hovering mist above the trees and grass", "e": {"sub": "https://megaplay.buzz/stream/s-2/1750/sub", "dub": "https://megaplay.buzz/stream/s-2/1750/dub"}}, {"n": 12, "t": "So the flower petals are scattered like the snow by the passing storm", "e": {"sub": "https://megaplay.buzz/stream/s-2/1751/sub", "dub": "https://megaplay.buzz/stream/s-2/1751/dub"}}, {"n": 13, "t": "Yet it is I who withers and wilts", "e": {"sub": "https://megaplay.buzz/stream/s-2/1752/sub", "dub": "https://megaplay.buzz/stream/s-2/1752/dub"}}, {"n": 14, "t": "The emotions experienced", "e": {"sub": "https://megaplay.buzz/stream/s-2/1753/sub", "dub": "https://megaplay.buzz/stream/s-2/1753/dub"}}, {"n": 15, "t": "As helpless autumn leaves are caught against the flow", "e": {"sub": "https://megaplay.buzz/stream/s-2/1754/sub", "dub": "https://megaplay.buzz/stream/s-2/1754/dub"}}, {"n": 16, "t": "Takes me away in haste", "e": {"sub": "https://megaplay.buzz/stream/s-2/1755/sub", "dub": "https://megaplay.buzz/stream/s-2/1755/dub"}}, {"n": 17, "t": "As my sleeves are wet with dew", "e": {"sub": "https://megaplay.buzz/stream/s-2/1756/sub", "dub": "https://megaplay.buzz/stream/s-2/1756/dub"}}, {"n": 18, "t": "The storm will soon carry me", "e": {"sub": "https://megaplay.buzz/stream/s-2/1757/sub", "dub": "https://megaplay.buzz/stream/s-2/1757/dub"}}, {"n": 19, "t": "Bring a life of everlasting love", "e": {"sub": "https://megaplay.buzz/stream/s-2/1758/sub", "dub": "https://megaplay.buzz/stream/s-2/1758/dub"}}, {"n": 20, "t": "May the scarlet kadsuras", "e": {"sub": "https://megaplay.buzz/stream/s-2/1759/sub", "dub": "https://megaplay.buzz/stream/s-2/1759/dub"}}, {"n": 21, "t": "To restore my faith", "e": {"sub": "https://megaplay.buzz/stream/s-2/1760/sub", "dub": "https://megaplay.buzz/stream/s-2/1760/dub"}}, {"n": 22, "t": "Just as my beauty has faded", "e": {"sub": "https://megaplay.buzz/stream/s-2/1761/sub", "dub": "https://megaplay.buzz/stream/s-2/1761/dub"}}, {"n": 23, "t": "Like a boatsman adrift", "e": {"sub": "https://megaplay.buzz/stream/s-2/1762/sub", "dub": "https://megaplay.buzz/stream/s-2/1762/dub"}}, {"n": 24, "t": "When winds send waves crashing", "e": {"sub": "https://megaplay.buzz/stream/s-2/1763/sub", "dub": "https://megaplay.buzz/stream/s-2/1763/dub"}}]}